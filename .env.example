# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit real values.
# Generate secrets with:  openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (required) ───────────────────────────────────────────────────────
# Any PostgreSQL 15+. `bun run db:up` starts the local one below.
DATABASE_URL=postgres://vante:vante@localhost:54329/vante
DATABASE_POOL_MAX=5

# ── Private dashboard (required) ──────────────────────────────────────────────
# URL segment of the dashboard, e.g. "my-private-panel" serves it at
ADMIN_PATH=

# The one account allowed in. `bun run admin:create` creates it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Secrets (required) ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
API_KEY_PEPPER=
CRON_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend is used whenever RESEND_API_KEY is set, otherwise SMTP below.
RESEND_API_KEY=
EMAIL_FROM=vante.app <noreply@vante.app>
SECURITY_ALERT_EMAIL=

# SMTP fallback, also used by the contact form when Resend is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Contact form ──────────────────────────────────────────────────────────────
CONTACT_EMAIL=contact@vante.app
CONTACT_TOKEN_SECRET=

# ── Last.fm music page (optional) ─────────────────────────
# Free key from https://www.last.fm/api/account/create. Set your Last.fm
# username in the dashboard under Site Text, on the Music tab.
LASTFM_API_KEY=

# ── Proxy and geolocation ─────────────────────────────────────────────────────
# Header holding the real client IP. Only set one your proxy overwrites, since
# clients can forge any other. Leave empty on Vercel and for x-forwarded-for.
TRUSTED_IP_HEADER=
# Header holding an ISO country code. Vercel and Cloudflare are detected
# automatically. Without one, countries show as "Unknown" and geographic
# detection stays quiet.
GEO_COUNTRY_HEADER=

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
