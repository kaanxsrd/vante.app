{
  "name": "vante.app",
  "version": "2.0.0",
  "description": "🌍 A fast personal site with a private control center behind it. Blog, projects, live Last.fm music, scoped API keys and threat detection, all editable from one dashboard.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check . && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=react-server test ./tests/unit",
    "test:integration": "bun --conditions=react-server test ./tests/integration --timeout 30000",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun --conditions=react-server run scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "bun --conditions=react-server run scripts/create-admin.ts",
    "worker": "bun --conditions=react-server run scripts/worker.ts"
  },
  "dependencies": {
    "@iconify-json/devicon": "^1.2.78",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify/utils": "^3.1.7",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fumadocs-core": "^16.18.3",
    "fumadocs-ui": "^16.18.3",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.4.0",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.37.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "mdast-util-to-hast": "^13.2.1",
    "esbuild": "^0.25.12"
  }
}
